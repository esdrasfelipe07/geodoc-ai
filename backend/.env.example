# ==========================================
# GeoDoc AI — Backend Configuration
# ==========================================

# Application Settings
PROJECT_NAME="GeoDoc AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Paths
UPLOAD_DIR="data/uploads"
CHROMA_PERSIST_DIR="data/vectorstore"
CHROMA_COLLECTION_NAME="geodoc_documents"

# LLM Provider Configuration ("openai" | "ollama" | "mock")
LLM_PROVIDER="mock"

# OpenAI Settings (required if LLM_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.2

# Ollama Settings (required if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Model Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
