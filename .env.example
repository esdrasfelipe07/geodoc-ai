# ==============================================================================
# GeoDoc AI — Variáveis de Ambiente do Docker Compose
# ==============================================================================

# Provedor de IA: "mock" (padrão, sem custos), "openai" ou "ollama"
LLM_PROVIDER=mock

# Configurações OpenAI (necessário se LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Configurações Ollama (necessário se LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Portas dos Serviços
BACKEND_PORT=8000
FRONTEND_PORT=3000
